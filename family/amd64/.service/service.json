{
    "tag": "celaut-demo-family",
    "api": [
        {
            "port": 8080,
            "protocol": [
                "http"
            ]
        }
    ],
    "architecture": "linux/amd64",
    "init": {
        "entry_path": [
            "service",
            "run.sh"
        ]
    },
    "envs": [],
    "resources": {
        "at_init": {
            "mem_limit": 50000000,
            "disk_space": 200000000
        },
        "at_most": {
            "mem_limit": 50000000,
            "disk_space": 200000000
        }
    },
    "initial_environment_workload": [
        {
            "any_of": [
                {
                    "workloads": [
                        {
                            "count": 1,
                            "dependency": {
                                "service": {
                                    "container": {
                                        "architecture": {
                                            "tags": [
                                                "linux/amd64"
                                            ]
                                        },
                                        "resources": {
                                            "at_init": {
                                                "mem_limit": 50000000,
                                                "disk_space": 200000000
                                            },
                                            "at_most": {
                                                "mem_limit": 50000000,
                                                "disk_space": 200000000
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    ]
                }
            ]
        }
    ]
}
