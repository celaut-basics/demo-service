        },
        "at_most": {
            "mem_limit": 2000000000,
            "disk_space": 8000000000
        }
    },
    "network": [
        {
            "tags": [
                "google.com",
                "www.google.com"
            ],
            "prose": "Connection to Google Search Engine."
        },
        {
            "tags": [
                "amazon.com",
                "www.amazon.com"
            ],
            "prose": "Connection to Amazon."
        }
    ],
    "shared_filesystems": [
        {
            "path": "/shared",
            "role": "shared",
            "tag": "demo-share"
        },
        {
            "path": "/shared-ro",
            "role": "shared",
            "tag": "demo-share-ro"
        }
    ]
