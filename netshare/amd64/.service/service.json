{
    "tag": "netshare",
    "api": [
        {
            "port": 3030,
            "protocol": [
                "http"
            ]
        }
    ],
    "architecture": "linux/amd64",
    "init": {
        "entry_path": [
            "netshare-service"
        ]
    },
    "envs": [
        "DEMO_NETSHARE_GROUP"
    ],
    "resources": {
        "at_init": {
            "mem_limit": 50000000,
            "disk_space": 200000000
        },
        "at_most": {
            "mem_limit": 50000000,
            "disk_space": 200000000
        }
    },
    "network": [
        {
            "tags": [
                "celaut-demo-netshare"
            ],
            "prose": "The members of one demo network share. The group selects the share.",
            "formal": {
                "group": "${DEMO_NETSHARE_GROUP}"
            }
        }
    ],
    "shared_filesystems": [
        {
            "path": "/netshare",
            "role": "network",
            "network": "celaut-demo-netshare",
            "tag": "demo-netshare"
        }
    ]
}
